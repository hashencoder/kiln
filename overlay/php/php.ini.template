; =====================================================================
;  WebHut - php.ini (development)
;  Generated by WebHut from php.ini.template when this PHP version was
;  installed. Edit freely; WebHut only rewrites the root path if you
;  move the WebHut folder.
;  webhut-root: {{WEBHUT_ROOT}}
;  Anything not listed here uses PHP's built-in default.
; =====================================================================

[PHP]
engine = On
short_open_tag = Off
expose_php = Off

; --- Errors: show everything while developing ---
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{WEBHUT_ROOT}}/logs/php_errors.log"

; --- Limits: generous for local work ---
memory_limit = 512M
max_execution_time = 120
max_input_time = 120
max_input_vars = 5000
post_max_size = 128M
upload_max_filesize = 128M
max_file_uploads = 50

; --- Paths ---
extension_dir = "{{PHP_DIR}}/ext"
upload_tmp_dir = "{{WEBHUT_ROOT}}/tmp/uploads"
sys_temp_dir = "{{WEBHUT_ROOT}}/tmp"
include_path = ".;{{PHP_DIR}}/pear"

; --- Misc ---
default_charset = "UTF-8"
variables_order = "EGPCS"
request_order = "GP"
allow_url_fopen = On
file_uploads = On
realpath_cache_size = 4096K

; --- Extensions ---
; WebHut enables every extension below that exists in this PHP build.
{{EXTENSIONS}}

[Date]
date.timezone = "{{TIMEZONE}}"

[Session]
session.save_handler = files
session.save_path = "{{WEBHUT_ROOT}}/tmp/sessions"
session.use_strict_mode = 1
session.cookie_httponly = 1
session.gc_maxlifetime = 7200

[mail function]
; No mail server is bundled. Use a catcher such as Mailpit and set SMTP here.
SMTP = localhost
smtp_port = 1025

[curl]
; Windows PHP builds ship without CA certificates. WebHut downloads
; the Mozilla CA bundle so HTTPS requests from PHP work.
curl.cainfo = "{{WEBHUT_ROOT}}/ssl/cacert.pem"

[openssl]
openssl.cafile = "{{WEBHUT_ROOT}}/ssl/cacert.pem"

[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 128
opcache.max_accelerated_files = 20000
; Re-check files on every request so code edits show up immediately.
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0

; Xdebug is not bundled. To use it, download the matching DLL from
; https://xdebug.org/download into ext\ and add:
; zend_extension = xdebug
; xdebug.mode = debug
; xdebug.start_with_request = trigger
